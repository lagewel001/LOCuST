            "spin"@sl,
            "Spin"@tr,
            "自旋"@zh ;
        dcterms:description """In quantum mechanics and particle physics "Spin" is an intrinsic form of angular momentum carried by
    elementary particles, composite particles (hadrons), and atomic nuclei.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:ERG-SEC,
            unit:EV-SEC,
