        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:TimeRelatedLogarithmicRatio a qudt:QuantityKind ;
        rdfs:label "Time-related Logarithmic Ratio"@en-us ;
        dcterms:description """logarithm of the ratio of the value of a defined variable to the value of a reference variable of the
    same type, divided by the related time
  """@en ;
