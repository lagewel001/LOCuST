        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:CoefficientOfHeatTransfer .

    quantitykind:ThermalCoefficientOfLinearExpansion a qudt:QuantityKind ;
        rdfs:label "Thermal Coefficient of Linear Expansion"@en-us ;
        dcterms:description """median relative change in length over a specific length of the test piece, divided by the temperature
    range caused by it
  """@en ;
        qudt:eclassCode "0173-1#Z4-BAJ473#002"^^xsd:string ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H-1T0D0 ;
        qudt:plainTextDescription """auf eine festgelegte Länge des Probekörpers bezogene mittlere relative Längenänderung dividiert
    durch die sie verursachende Temperaturänderung
  """@de ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:ThermalInsulation a qudt:QuantityKind ;
        rdfs:label "Thermal Insulation"@en-us ;
        dcterms:description """temperature difference between two surfaces divided by areic heat flow rate in the direction of the
    temperature gradient
  """@en ;
        qudt:eclassCode "0173-1#Z4-BAJ404#002"^^xsd:string ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M-1H1T3D0 ;
