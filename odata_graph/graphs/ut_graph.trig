    quantitykind:FastFissionFactor a qudt:QuantityKind ;
        rdfs:label "Fast Fission Factor"@en ;
        dcterms:description """"Fast Fission Factor" in an infinite medium, is the ratio of the mean number of neutrons produced by
    fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:UNITLESS ;
