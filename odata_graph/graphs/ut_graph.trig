    quantitykind:VisibleRadiantEnergy a qudt:QuantityKind ;
        rdfs:label "Visible Radiant Energy"@en ;
        dcterms:description """"Visible Radiant Energy", also known as luminous energy, is the energy of electromagnetic waves. It is
    energy of the particles that are emitted, transferred, or received as radiation.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:AttoJ,
