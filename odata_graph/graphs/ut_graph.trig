        qudt:latexDefinition "$\\omega_c = \\frac{\\left | q \\right |}{m}B$, where $q$ is the electric charge, $m$ is its mass, and $B$ is the magnetic flux density."^^qudt:LatexString ;
        qudt:latexSymbol "$\\omega_c$"^^qudt:LatexString ;
