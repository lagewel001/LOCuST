            "Açısal hız"@tr,
            "角速度"@zh ;
        dcterms:description """Angular Velocity refers to how fast an object rotates or revolves relative to another point.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:DEG-PER-HR,
