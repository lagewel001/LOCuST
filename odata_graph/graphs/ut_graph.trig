        qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB110"^^xsd:anyURI,
            "https://en.wikipedia.org/wiki/Knot?oldid=495066194"^^xsd:anyURI ;
        qudt:symbol "kn"^^xsd:string ;
        qudt:ucumCode "[kn_i]"^^qudt:UCUMcs ;
        qudt:udunitsCode "kt"^^xsd:string ;
        qudt:uneceCommonCode "KNT"^^xsd:string ;
