        qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI ;
        qudt:organizedUnder quantitykind:QuantumNumber ;
        qudt:plainTextDescription """The "Magnetic Quantum Number" describes the specific orbital (or "cloud") within that subshell, and
    yields the projection of the orbital angular momentum along a specified axis.
  """^^xsd:string ;
        qudt:symbol "m"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q2009727> ;
