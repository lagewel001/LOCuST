            "Curie sıcaklığı"@tr,
            "居里点"@zh ;
        dcterms:description "\"Curie Temperature\" is the critical thermodynamic temperature of a ferromagnet."^^qudt:LatexString ;
        qudt:applicableUnit unit:DEG_C,
            unit:DEG_C_GROWING_CEREAL,
            unit:DEG_F,
            unit:DEG_R,
            unit:DecaK,
