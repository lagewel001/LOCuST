    quantitykind:ShearModulus a qudt:QuantityKind ;
        rdfs:label "Shear Modulus"@en ;
        dcterms:description """The Shear Modulus or modulus of rigidity, denoted by $G$, or sometimes $S$ or $\\mu$, is defined as the
    ratio of shear stress to the shear strain.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:DecaPA,
            unit:GigaPA,
            unit:HectoPA,
