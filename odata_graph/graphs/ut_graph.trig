    quantitykind:TotalCurrent a qudt:QuantityKind ;
        rdfs:label "Total Current"@en ;
        dcterms:description """"Total Current" is the sum of the electric current that is flowing through a surface and the displacement
    current.
  """^^qudt:LatexString ;
