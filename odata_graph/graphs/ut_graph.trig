        qudt:scalingOf unit:M2 ;
        qudt:symbol "cmil"^^xsd:string ;
        qudt:ucumCode "[cml_i]"^^qudt:UCUMcs ;
        qudt:uneceCommonCode "M47"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:Area,
