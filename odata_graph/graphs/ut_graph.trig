    quantitykind:RestMass a qudt:QuantityKind ;
        rdfs:label "كتلة ساكنة"@ar,
            "Klidová hmotnost"@cs,
            "Ruhemasse"@de,
            "Rest Mass"@en,
            "masa invariante"@es,
            "جرم سکون"@fa,
