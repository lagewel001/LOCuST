    quantitykind:FrictionCoefficient a qudt:QuantityKind ;
        rdfs:label "Friction Coefficient"@en ;
        dcterms:description """"Friction Coefficient" is the ratio of the force of friction between two bodies and the force pressing
    them together
  """^^qudt:LatexString ;
