    unit:U a qudt:Unit ;
        rdfs:label "Unified Atomic Mass Unit"^^xsd:string,
            "Unified Atomic Mass Unit"@en ;
        dcterms:description """The unified atomic mass unit (symbol: $u$) or dalton (symbol: $Da$) is the standard unit that is used for
    indicating mass on an atomic or molecular scale (atomic mass). It is defined as one twelfth of the mass of an unbound neutral
    atom of carbon-12 in its nuclear and electronic ground state,[ and has a value of $1.660538921(73) \\times 10^{-27} kg$. One
    dalton is approximately equal to the mass of one nucleon; an equivalence of saying $1 g mol^{-1}$. The CIPM have categorised
    it as a 'non-SI unit' because units values in SI units must be obtained experimentally.
  """^^qudt:LatexString ;
        qudt:conversionMultiplier 0.00000000000000000000000000166053878283 ;
        qudt:conversionMultiplierSN 1.660539e-27 ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Atomic_mass_unit"^^xsd:anyURI ;
        qudt:exactMatch unit:AMU,
