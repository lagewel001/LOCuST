    unit:OHM_Ab a qudt:Unit ;
        rdfs:label "Abohm"^^xsd:string,
            "Abohm"@en ;
        dcterms:description """$\\textit{abohm}$ is the basic unit of electrical resistance in the emu-cgs system of units. One abohm is
    equal to $10^{-9} ohms$ in the SI system of units; one abohm is a nano ohm.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-EMU ;
        qudt:conversionMultiplier 0.000000001 ;
        qudt:conversionMultiplierSN 1e-09 ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Abohm"^^xsd:anyURI ;
