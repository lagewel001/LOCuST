            "https://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions"^^xsd:anyURI ;
        qudt:qkdvDenominator qkdv:A0E0L1I0M0H0T0D0 ;
