            unit:MilliGM-PER-DeciM2,
            unit:MilliGM-PER-HA,
            unit:MilliGM-PER-M2,
            unit:NanoGM-PER-CentiM2,
            unit:OZ-PER-FT2,
            unit:OZ-PER-IN2,
            unit:OZ-PER-YD2,
            unit:SLUG-PER-FT2,
            unit:TONNE-PER-HA,
            unit:TON_Metric-PER-HA ;
        qudt:hasDimensionVector qkdv:A0E0L-2I0M1H0T0D0 ;
        qudt:informativeReference "http://www.oxfordreference.com/view/10.1093/acref/9780198631477.001.0001/acref-9780198631477-e-254"^^xsd:anyURI ;
        qudt:specializationOf quantitykind:MassPerArea ;
