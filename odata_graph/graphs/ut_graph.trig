    quantitykind:EnergyPerArea a qudt:QuantityKind ;
        rdfs:label "Energy per Area"@en ;
        dcterms:description """Energy per unit area is a measure of the energy either impinging upon or generated from a given unit of
    area. This can be a measure of the "toughness" of a material, being the amount of energy that needs to be applied per unit
    area of a crack to cause it to fracture. This is a constant for a given material..
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:BTU_IT-PER-FT2,
            unit:BTU_TH-PER-FT2,
            unit:CAL_TH-PER-CentiM2,
            unit:CentiN-M-PER-M2,
            unit:ERG-PER-CentiM2,
            unit:FT-LB_F-PER-FT2,
            unit:FT-LB_F-PER-M2,
            unit:GigaJ-PER-M2,
