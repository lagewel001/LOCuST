    quantitykind:MolarOpticalRotationalAbility a qudt:QuantityKind ;
        rdfs:label "Molar Optical Rotational Ability"@en-us ;
        dcterms:description """material-specific quantity resulting as the specific angle of rotation of a substance for a particular
    wavelength and a particular temperature from the relationship: ratio between measured angle of rotation divided by the
    concentration of material and the covered path
  """@en ;
        qudt:eclassCode "0173-1#Z4-BAJ426#001"^^xsd:string ;
        qudt:hasDimensionVector qkdv:A0E0L2I0M-1H0T0D0 ;
        qudt:plainTextDescription """materialspezifische Größe, die sich als spezifischer Drehwinkel einer Substanz für eine bestimmte
    Wellenlänge und eine bestimmte Temperatur ergibt durch die Beziehung: Quotient aus gemessener Drehwinkel dividiert durch die
    Stoffmenegenkonzentration und die durchstrahlte Wegstrecke
  """@de ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

