            unit:THM_US,
            unit:TOE,
            unit:TeraJ,
            unit:TeraW-HR,
            unit:TonEnergy,
            unit:W-HR,
            unit:W-SEC ;
        qudt:hasDimensionVector qkdv:A0E0L2I0M1H0T-2D0 ;
        qudt:informativeReference "https://en.wikipedia.org/wiki/Band_gap"^^xsd:anyURI ;
        qudt:normativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI ;
        qudt:plainTextDescription """"Gap Energy" is the difference in energy between the lowest level of conduction band and the
    highest level of valence band. It is an energy range in a solid where no electron states can exist.
  """^^xsd:string ;
        qudt:specializationOf quantitykind:Energy ;
        qudt:symbol "E_g"^^xsd:string ;
        rdfs:comment "Applicable units are those of quantitykind:Energy"^^xsd:string ;
