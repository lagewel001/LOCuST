    unit:ST a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Stokes"^^xsd:string,
            "Stokes"@en ;
        dcterms:description """$\\textit{Stokes (St)}$ is a unit in the category of Kinematic viscosity. This unit is commonly used in
    the cgs unit system. Stokes (St) has a dimension of $L^2T^{-1}$ where $L$ is length, and $T$ is time. It can be converted to
    the corresponding standard SI unit $m^2/s$ by multiplying its value by a factor of 0.0001.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS ;
        qudt:conversionMultiplier 0.0001 ;
        qudt:conversionMultiplierSN 1e-04 ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Stokes"^^xsd:anyURI ;
        qudt:derivedUnitOfSystem sou:CGS ;
        qudt:factorUnitScalar 0.0001 ;
        qudt:hasDimensionVector qkdv:A0E0L2I0M0H0T-1D0 ;
