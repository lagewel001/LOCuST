        rdfs:label "Curvature"@en ;
        dcterms:description """In mathematics "Curvature" is the amount by which a geometric object deviates from being flat, or
    straight in the case of a line, but this is defined in different ways depending on the context.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:PER-KiloM,
