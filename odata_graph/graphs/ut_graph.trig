    quantitykind:SecondRadiationConstant a qudt:QuantityKind ;
        rdfs:label "Second Radiation Constant"@en-us ;
        dcterms:description """constant in Planck's radiation law on the dependence of the spectral density of various radiation
    variables on the wavelength of the electromagnetic radiation and the absolute temperature of the black radiator, derived from
    the product of Planck's quantum of action times the velocity of light in relation to Boltzmann's constant
  """@en ;
        qudt:eclassCode "0173-1#Z4-BAJ428#001"^^xsd:string ;
        qudt:hasDimensionVector qkdv:A0E0L1I0M0H1T0D0 ;
        qudt:plainTextDescription """Konstante im Planckschen Strahlungsgesetz über die Abhängigkeit der spektralen Dichte verschiedener
    Strahlungsgrößen von der Wellenlänge der elektromagnetischen Strahlung und der absoluten Temperatur beim schwarzen Strahler,
    welche sich zusammensetzt aus dem Produkt Plancksches Wirkungsquantum mal Lichtgeschwindigkeit bezogen auf die
    Boltzmann-Konstante
  """@de ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

