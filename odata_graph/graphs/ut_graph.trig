   must be a plain string, a string with HTML markup, or a string with LaTeX markup.
  """^^xsd:string ;
        rdf:first _:ne65d4cbea54444c6960902e3884365fdb181 ;
        rdf:rest _:ne65d4cbea54444c6960902e3884365fdb184 ;
