    quantitykind:BendingMomentOfForce a qudt:QuantityKind ;
        rdfs:label "Bending Moment of Force"@en ;
        dcterms:description """A bending moment exists in a structural element when a moment is applied to the element so that the
    element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:CentiN-M,
            unit:DYN-CentiM,
            unit:DYN-M,
            unit:DeciN-M,
