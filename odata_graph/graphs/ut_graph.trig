    unit:DARCY a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Darcy"^^xsd:string,
            "Darcy"@en ;
        dcterms:description """<p>The $darcy$ (d) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is
    widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow
    of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined.
    A darcy has dimensional units of length<sup>2</sup>.</p>
  """^^rdf:HTML ;
        qudt:applicableSystem sou:CGS,
            sou:SI ;
        qudt:conversionMultiplier 0.0000000000009869233 ;
        qudt:conversionMultiplierSN 9.869233e-13 ;
