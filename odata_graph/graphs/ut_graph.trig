    unit:A a qudt:Unit ;
        rdfs:label "Ampere"^^xsd:string,
            "أمبير"@ar,
            "Ампер"@bg,
            "Ampér"@cs,
            "Ampere"@de,
            "Αμπέρ"@el,
            "Ampere"@en,
            "Amperio"@es,
            "آمپر"@fa,
            "Ampère"@fr,
            "אמפר"@he,
            "एम्पीयर"@hi,
            "Amper"@hu,
            "Ampere"@it,
            "アンペア"@ja,
