            "https://en.wikipedia.org/wiki/Thermal_insulation"^^xsd:anyURI ;
        qudt:latexDefinition "$M = 1/K$, where $K$ is \"Coefficient of Heat Transfer\""^^qudt:LatexString ;
        qudt:symbol "M"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q2596212> ;
