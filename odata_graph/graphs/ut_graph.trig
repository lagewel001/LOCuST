        qudt:hasDimensionVector qkdv:A0E0L0I0M0H1T0D0 ;
        qudt:plainTextDescription """the temperature of a parcel of air cooled to saturation (100% relative humidity) by the evaporation
    of water into it, with the latent heat supplied by the parcel.
  """^^xsd:string ;
        qudt:specializationOf quantitykind:Temperature ;
        rdfs:comment "Applicable units are those of quantitykind:Temperature"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:Temperature .

