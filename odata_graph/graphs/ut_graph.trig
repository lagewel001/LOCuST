    drag or resistance of an object in a fluid environment such as air or water.
  """^^xsd:string ;
        qudt:qkdvDenominator qkdv:A0E0L1I0M1H0T-2D0 ;
        qudt:qkdvNumerator qkdv:A0E0L1I0M1H0T-2D0 ;
        qudt:symbol "C_D"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q1778961> ;
        rdfs:comment "Applicable units are those of quantitykind:DragCoefficient"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:Dimensionless .

