    unit:STR a qudt:Unit ;
        rdfs:label "Stere"^^xsd:string,
            "Stere"@en ;
        dcterms:description """The stere is a unit of volume in the original metric system equal to one cubic metre.  The stere is
    typically used for measuring large quantities of firewood or other cut wood, while the cubic meter is used for uncut wood. It
    is not part of the modern metric system (SI). In Dutch there's also a kuub, short for kubieke meter which is similar but
    different.
  """^^rdf:HTML ;
        qudt:conversionMultiplier 1.0 ;
        qudt:conversionMultiplierSN 1e+00 ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/St%C3%A8re"^^xsd:anyURI ;
