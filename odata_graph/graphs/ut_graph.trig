    quantitykind:AmbientPressure a qudt:QuantityKind ;
        rdfs:label "Ambient Pressure"@en ;
        dcterms:description """The ambient pressure on an object is the pressure of the surrounding medium, such as a gas or liquid,
    which comes into contact with the object. The SI unit of pressure is the pascal (Pa), which is a very small unit relative to
    atmospheric pressure on Earth, so kilopascals ($kPa$) are more commonly used in this context.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:ATM,
            unit:ATM_T,
