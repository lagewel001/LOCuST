        dcterms:description """Mortality rate, or death rate, is a measure of the number of deaths (in general, or due to a specific
    cause) in a particular population, scaled to the size of that population, per unit of time.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:DEATHS-PER-KiloINDIV-YR,
            unit:DEATHS-PER-MegaINDIV-YR ;
