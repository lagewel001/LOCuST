        qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI ;
        qudt:organizedUnder quantitykind:QuantumNumber ;
        qudt:plainTextDescription """The "Hyperfine Structure Quantum Number" is a quantum number of an atom describing inclination of
    the nuclear spin with respect to a quantization axis given by the magnetic field produced by the orbital electrons.
  """^^xsd:string ;
        qudt:symbol "F"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q97577449> ;
        rdfs:comment "Applicable units are those of quantitykind:HyperfineStructureQuantumNumber"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:QuantumNumber .

    quantitykind:Incidence a qudt:QuantityKind ;
        rdfs:label "Incidence"@en ;
        dcterms:description """In epidemiology, incidence is a measure of the probability of occurrence of a given medical condition in
    a population within a specified period of time.
  """^^qudt:LatexString ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T-1D0 ;
