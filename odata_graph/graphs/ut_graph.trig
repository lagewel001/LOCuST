        rdfs:comment "Applicable units are those of quantitykind:MassRatio"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:Resistance a qudt:QuantityKind ;
        rdfs:label "Resistance"@en ;
        dcterms:description """The electrical resistance of an object is a measure of its opposition to the passage of a steady electric
    current.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:GigaOHM,
            unit:KiloOHM,
            unit:MegaOHM,
            unit:MicroOHM,
            unit:MilliOHM,
            unit:OHM,
