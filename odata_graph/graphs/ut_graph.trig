            "Relative Electromagnetic Permeability"@en ;
        dcterms:description """Relative permeability, denoted by the symbol $\\mu _T$, is the ratio of the permeability of a specific
    medium to the permeability of free space $\\mu _0$
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS-EMU ;
        qudt:conversionMultiplier 1.0 ;
        qudt:conversionMultiplierSN 1e+00 ;
