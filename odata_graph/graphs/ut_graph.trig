            "https://en.wikipedia.org/wiki/Lux?oldid=494700274"^^xsd:anyURI ;
        qudt:siUnitsExpression "lm-h/m^2"^^xsd:string ;
        qudt:symbol "lx·h"^^xsd:string ;
        qudt:ucumCode "lx.h"^^qudt:UCUMcs ;
