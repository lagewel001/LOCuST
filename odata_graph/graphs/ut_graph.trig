    unit:DEG2 a qudt:Unit ;
        rdfs:label "Square Degree"^^xsd:string,
            "Square Degree"@en ;
        dcterms:description """A square degree is a non-SI unit measure of solid angle. It is denoted in various ways, including deg,
    sq. deg. and $\\circ^2$. Just as degrees are used to measure parts of a circle, square degrees are used to measure parts of a
    sphere. Analogous to one degree being equal to $\\pi /180 radians$, a square degree is equal to ($\\pi /180)$ or about 1/3283
    steradian. The number of square degrees in a whole sphere is or approximately 41 253 deg. This is the total area of the 88
    constellations in the list of constellations by area. For example, observed from the surface of the Earth, the Moon has a
    diameter of approximately $0.5^\\circ$, so it covers a solid angle of approximately 0.196 deg, which is $4.8 \\times 10$ of
    the total sky sphere.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:ASU,
            sou:CGS,
            sou:CGS-EMU,
            sou:CGS-ESU,
            sou:CGS-GAUSS,
            sou:IMPERIAL,
            sou:PLANCK,
            sou:SI ;
        qudt:conversionMultiplier 0.0003046174197867085993467435493788937 ;
        qudt:conversionMultiplierSN 3.046174e-04 ;
        qudt:expression "$deg^2$"^^qudt:LatexString ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb819 ;
        qudt:hasQuantityKind quantitykind:SolidAngle ;
        qudt:symbol "°²"^^xsd:string ;
        qudt:ucumCode "deg2"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:SolidAngle ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q254532> ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

