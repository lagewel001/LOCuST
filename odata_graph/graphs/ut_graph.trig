    quantitykind:ThomsonCoefficient a qudt:QuantityKind ;
        rdfs:label "Thomson Coefficient"@en ;
        dcterms:description """"Thomson Coefficient" represents Thomson heat power developed, divided by the electric current and the
    temperature difference.
  """^^qudt:LatexString ;
