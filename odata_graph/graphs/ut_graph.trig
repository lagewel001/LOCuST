        rdfs:comment "Applicable units are those of quantitykind:ElectricChargePerArea"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:InverseLength a qudt:QuantityKind ;
        rdfs:label "Inverse Length"@en ;
        dcterms:description """Reciprocal length or inverse length is a measurement used in several branches of science and mathematics.
    As the reciprocal of length, common units used for this measurement include the reciprocal metre or inverse metre ($m^{-1}$),
    the reciprocal centimetre or inverse centimetre ($cm^{-1}$), and, in optics, the dioptre.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:KY,
