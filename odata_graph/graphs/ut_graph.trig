        rdfs:comment "Applicable units are those of quantitykind:NumberDensity"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:NumberDensity .

