            unit:C_Stat-PER-CentiM2,
            unit:KiloC-PER-M2,
            unit:MegaC-PER-M2,
            unit:MicroC-PER-M2,
            unit:MilliC-PER-M2 ;
        qudt:hasDimensionVector qkdv:A0E1L-2I0M0H0T1D0 ;
