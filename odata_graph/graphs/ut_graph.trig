        qudt:plainTextDescription """"Debye Angular Wavenumber" is the cut-off angular wavenumber in the Debye model of the vibrational
    spectrum of a solid.
  """^^xsd:string ;
        qudt:specializationOf quantitykind:AngularWavenumber ;
        qudt:symbol "q_D"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q105554370> ;
