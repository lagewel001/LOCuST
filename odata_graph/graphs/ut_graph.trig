        rdfs:comment "Applicable units are those of quantitykind:ElevationRelativeToNAP"^^xsd:string,
            """Height measurement relative to the Normaal Amsterdams Peil (NAP) (en: Amsterdam Ordnance System). Being a form
    of gravity related height
  """^^xsd:string ;
