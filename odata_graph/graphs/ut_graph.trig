    quantitykind:LinkedFlux a qudt:QuantityKind ;
        rdfs:label "Linked Flux"@en ;
        dcterms:description """"Linked Flux" is defined as the path integral of the magnetic vector potential. This is the line integral
    of a magnetic vector potential $A$ along a curve $C$. The line vector element $dr$ is the differential of position vector $r$.
  """^^qudt:LatexString ;
