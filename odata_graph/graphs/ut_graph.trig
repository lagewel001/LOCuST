        rdfs:comment "Applicable units are those of quantitykind:LinearBitDensity"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:LinearResistance a qudt:QuantityKind ;
