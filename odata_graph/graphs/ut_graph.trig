    unit:AC a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Acre"^^xsd:string,
            "Acre"@en ;
        dcterms:description """The acre is a unit of area in a number of different systems, including the imperial and U.S. customary
    systems. Its international symbol is ac. The most commonly used acres today are the international acre and, in the United
    States, the survey acre. The most common use of the acre is to measure tracts of land. One international acre is equal to
    4046.8564224 square metres.
  """^^rdf:HTML ;
        qudt:applicableSystem sou:IMPERIAL,
            sou:USCS ;
        qudt:conversionMultiplier 4046.8564224 ;
        qudt:conversionMultiplierSN 4.046856e+03 ;
