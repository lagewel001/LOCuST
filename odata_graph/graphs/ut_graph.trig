    quantitykind:WaterSolubility a qudt:QuantityKind ;
        rdfs:label "Water Solubility"@en ;
        dcterms:description """An amount of substance per unit volume that is the concentration of a saturated solution expressed as the
    ratio of the solute concentration over the volume of water.  A substance's solubility fundamentally depends on several
    physical and chemical properties of the solution as well as the environment it is in.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:FemtoMOL-PER-L,
            unit:KiloMOL-PER-M3,
            unit:MOL-PER-DeciM3,
