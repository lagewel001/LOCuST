        qudt:scalingOf unit:M3 ;
        qudt:symbol "tbsp"^^xsd:string ;
        qudt:ucumCode "[tbs_us]"^^qudt:UCUMcs ;
        qudt:udunitsCode "Tbl"^^xsd:string,
