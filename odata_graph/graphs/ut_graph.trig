            "https://en.wikipedia.org/wiki/Rate_of_change_of_frequency"^^xsd:anyURI ;
        qudt:isoNormativeReference "https://www.iso.org/standard/64979.html"^^xsd:anyURI ;
        qudt:organizedUnder quantitykind:InverseSquareTime ;
        qudt:plainTextDescription """The "Rate of Change of Frequency" is the rate of change of frequency with respect to time. It
    is used in power systems to describe the rate at which the frequency of the system is changing.
  """^^xsd:string ;
        qudt:symbol "ROCOF"^^xsd:string ;
        rdfs:comment "Applicable units are those of quantitykind:RateOfChangeOfFrequency"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:InverseSquareTime .

