        qudt:plainTextDescription """Transmittance is the fraction of incident light (electromagnetic radiation) at a specified
    wavelength that passes through a sample.
  """^^xsd:string ;
        qudt:symbol "A_10, D"^^xsd:string ;
        rdfs:comment "Applicable units are those of quantitykind:TransmittanceDensity"^^xsd:string ;
