        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:DimensionlessRatio .

    quantitykind:RateOfChangeOfFrequency a qudt:QuantityKind ;
        rdfs:label "Rate of Change of Frequency"@en ;
        dcterms:description """The "Rate of Change of Frequency" is the rate of change of frequency with respect to time. It is used in
    power systems to describe the rate at which the frequency of the system is changing.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:HZ-PER-SEC ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T-2D0 ;
