    quantitykind:MagneticQuantumNumber a qudt:QuantityKind ;
        rdfs:label "Magnetic Quantum Number"@en ;
        dcterms:description """The "Magnetic Quantum Number" describes the specific orbital (or "cloud") within that subshell, and
    yields the projection of the orbital angular momentum along a specified axis.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:UNITLESS ;
