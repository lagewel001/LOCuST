    unit:CentiM a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Centimetre"^^xsd:string,
            "Centimetr"@cs,
            "Centimeter"@de,
            "Centimetre"@en,
            "Centimeter"@en-us,
            "Centimetro"@es,
            "Centimètre"@fr,
