        qudt:definedUnitOfSystem sou:IMPERIAL,
            sou:USCS ;
        qudt:expression "$ft/s$"^^qudt:LatexString ;
        qudt:hasDimensionVector qkdv:A0E0L1I0M0H0T-1D0 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb1074,
