            unit:PER-YR,
            unit:PERCENT-PER-DAY,
            unit:PERCENT-PER-HR,
            unit:PERCENT-PER-MO,
            unit:PPTH-PER-HR,
            unit:PetaHZ,
            unit:PlanckFrequency,
            unit:TeraHZ ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Frequency"^^xsd:anyURI ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T-1D0 ;
