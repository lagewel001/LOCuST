        rdfs:label "Reaction Rate Constant"@en ;
        dcterms:description """A quantity kind that is a proportionality constant that quantifies the relationship between the molar
    concentrations of the reactants and the rate of a second order chemical reaction.
  """^^qudt:LatexString ;
