        qudt:iec61360Code "0112/2///62720#UAD203"^^xsd:string ;
        qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD203"^^xsd:anyURI,
            "https://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)"^^xsd:anyURI ;
        qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI ;
        qudt:latexDefinition "$S = -\\frac{dE}{dx}$, where $-dE$ is the energy decrement in the $x-direction$ along an elementary path with the length $dx$."^^qudt:LatexString ;
        qudt:plainTextDescription """The "Total Linear Stopping Power" is defined as the average energy loss of the particle per unit
    path length.
  """^^xsd:string ;
        qudt:symbol "S"^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q908474> ;
        rdfs:comment "Applicable units are those of quantitykind:TotalLinearStoppingPower"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

