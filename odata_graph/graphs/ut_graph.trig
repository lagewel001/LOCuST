            "https://physics.nist.gov/cuu/pdf/sp811.pdf"^^xsd:anyURI ;
        qudt:scalingOf unit:PA ;
        qudt:symbol "inH₂O"^^xsd:string ;
        qudt:ucumCode "[in_i'H2O]"^^qudt:UCUMcs ;
        qudt:uneceCommonCode "F78"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:ForcePerArea,
