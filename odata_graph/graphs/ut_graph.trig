    quantitykind:SoundParticleAcceleration a qudt:QuantityKind ;
        rdfs:label "Sound Particle Acceleration"@en ;
        dcterms:description """In a compressible sound transmission medium - mainly air - air particles get an accelerated motion: the
    particle acceleration or sound acceleration with the symbol a in $m/s2$. In acoustics or physics, acceleration (symbol: $a$)
    is defined as the rate of change (or time derivative) of velocity.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:CentiM-PER-SEC2,
            unit:FT-PER-SEC2,
            unit:G,
            unit:GALILEO,
            unit:IN-PER-SEC2,
            unit:KN-PER-SEC,
            unit:KiloM-PER-SEC2,
