    quantitykind:SoundVolumeVelocity a qudt:QuantityKind ;
        rdfs:label "Sound Volume Velocity"@en ;
        dcterms:description """Sound Volume Velocity is the product of particle velocity $v$ and the surface area $S$ through which an
    acoustic wave of frequency $f$ propagates. Also, the surface integral of the normal component of the sound particle velocity
    over the cross-section (through which the sound propagates). It is used to calculate acoustic impedance.
  """^^qudt:LatexString ;
