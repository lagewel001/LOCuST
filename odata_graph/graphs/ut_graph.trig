        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

    unit:CYC a qudt:ContextualUnit,
            qudt:CountingUnit,
            qudt:Unit ;
        rdfs:label "Cycle"^^xsd:string,
            "Cycle"@en ;
        dcterms:description """One cycle: a single complete oscillation or repetition, treated here as a dimensionless counting
    unit (N=1, conversionMultiplier 1.0) so that unit:CYC-PER-SEC equals unit:HZ exactly. Although one cycle equals
    one revolution (2pi rad), the angular interpretation is captured by unit:REV (conversionMultiplier 2pi rad) rather
    than this unit. See unit:CYC-PER-SEC for the rationale."""^^xsd:string ;
        qudt:categorizedByQuantityKind quantitykind:Count ;
        qudt:conversionMultiplier 1.0 ;
        qudt:conversionMultiplierSN 1e+00 ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
        qudt:hasQuantityKind quantitykind:Count ;
        qudt:symbol "cycle"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> ;
        skos:broader unit:NUM .

    unit:C_Stat-PER-MOL a qudt:Unit ;
        rdfs:label "Statcoulomb per Mole"^^xsd:string,
            "Statcoulomb per Mole"@en ;
        dcterms:description """"Statcoulomb per Mole" is a unit of measure for the electical charge associated with one mole of a
    substance. The mole is a unit of measurement used in chemistry to express amounts of a chemical substance, defined as an
    amount of a substance that contains as many elementary entities (e.g., atoms, molecules, ions, electrons) as there are atoms
    in 12 grams of pure carbon-12 (12C), the isotope of carbon with atomic weight 12.
  """^^rdf:HTML ;
        qudt:applicableSystem sou:CGS ;
        qudt:conversionMultiplier 0.00000000033356409519815204957557671447492 ;
