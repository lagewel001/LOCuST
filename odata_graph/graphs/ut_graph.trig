            "Dyne per Square Centimetre"@en,
            "Dyne per Square Centimeter"@en-us ;
        dcterms:description """"Dyne per Square Centimeter" is a C.G.S System unit for  'Force Per Area' expressed as $dyn/cm^{2}$.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-GAUSS ;
        qudt:conversionMultiplier 0.1 ;
        qudt:conversionMultiplierSN 1e-01 ;
