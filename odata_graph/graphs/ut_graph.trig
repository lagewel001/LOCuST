        rdfs:comment "Applicable units are those of quantitykind:SoundExposureLevel"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

    quantitykind:SoundReductionIndex a qudt:QuantityKind ;
        rdfs:label "Sound Reduction Index"@en ;
        dcterms:description """The Sound Reduction Index is used to measure the level of sound insulation provided by a structure such
    as a wall, window, door, or ventilator.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:B,
