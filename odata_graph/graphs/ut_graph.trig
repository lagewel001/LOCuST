    unit:FM a qudt:Unit ;
        rdfs:label "Fermi"^^xsd:string,
            "Fermi"@en ;
        dcterms:description """The $\\textit{fermi}$, or $\\textit{femtometer}$ (other spelling $femtometre$, symbol $fm$) is an SI unit
    of length equal to $10^{-15} metre$. This distance is often encountered in nuclear physics as a characteristic of this scale.
    The symbol for the fermi is also $fm$.
  """^^qudt:LatexString ;
