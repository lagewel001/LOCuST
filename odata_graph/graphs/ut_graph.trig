            unit:LB-PER-LB,
            unit:MicroGM-PER-GM,
            unit:MicroGM-PER-KiloGM,
            unit:MicroGM-PER-MilliGM,
            unit:MilliGM-PER-GM,
            unit:MilliGM-PER-KiloGM,
            unit:NanoGM-PER-KiloGM,
            unit:NanoGM-PER-MilliGM,
            unit:PicoGM-PER-GM,
            unit:PicoGM-PER-KiloGM,
            unit:PicoGM-PER-MilliGM ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
        qudt:iec61360Code "0112/2///62720#UAD109"^^xsd:string ;
        qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD109"^^xsd:anyURI ;
        qudt:plainTextDescription """In aerospace engineering, mass ratio is a measure of the efficiency of a rocket. It describes how
    much more massive the vehicle is with propellant than without; that is, it is the ratio of the rocket's wet mass (vehicle plus
    contents plus propellant) to its dry mass (vehicle plus contents)
  """^^xsd:string ;
        qudt:symbol "R or M_{R}"^^xsd:string ;
