    quantitykind:WetBulbTemperature a qudt:QuantityKind ;
        rdfs:label "Wet Bulb Temperature"@en ;
        dcterms:description """The temperature of a parcel of air cooled to saturation (100% relative humidity) by the evaporation of
    water into it, with the latent heat supplied by the parcel.
  """^^qudt:LatexString ;
