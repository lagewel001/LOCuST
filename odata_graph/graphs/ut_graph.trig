    unit:SR a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Steradian"^^xsd:string,
            "ستراديان"@ar,
            "Стерадиан"@bg,
            "Steradián"@cs,
            "Steradiant"@de,
            "Στερακτίνιο"@el,
