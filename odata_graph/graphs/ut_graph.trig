    unit:LM a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Lumen"^^xsd:string,
            "لومن"@ar,
            "Лумен"@bg,
            "Lumen"@cs,
            "Lumen"@de,
            "Λούμεν"@el,
            "Lumen"@en,
            "Lumen"@es,
            "لومن"@fa,
            "Lumen"@fr,
            "לומן"@he,
