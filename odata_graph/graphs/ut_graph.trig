        skos:prefLabel "Elevation relative to NAP"@en,
            "Hoogte ten opzichte van NAP"@nl ;
        prov:wasDerivedFrom <https://www.opengis.net/def/crs/EPSG/0/5709> ;
        prov:wasInfluencedBy <https://epsg.io/5709> .

