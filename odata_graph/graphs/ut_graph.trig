    qudt:applicableSIUnit a rdf:Property ;
        rdfs:label "applicable SI unit"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/schema/shacl/qudt> ;
        rdfs:subPropertyOf qudt:applicableUnit .

