        qudt:uneceCommonCode "89"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:DynamicViscosity,
            quantitykind:Viscosity ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q2100949> ;
