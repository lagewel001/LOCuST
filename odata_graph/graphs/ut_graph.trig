    unit:RAD-PER-MIN a qudt:Unit ;
        rdfs:label "Radian per Minute"^^xsd:string,
            "Radian per Minute"@en ;
        dcterms:description """Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians
    per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the
    corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.
  """^^rdf:HTML ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-EMU,
            sou:CGS-GAUSS,
            sou:SI ;
        qudt:conversionMultiplier 0.01666666666666666666666666666666667 ;
