    quantitykind:EnergyExpenditure a qudt:QuantityKind ;
        rdfs:label "Energy Expenditure"@en ;
        dcterms:description """Energy expenditure is dependent on a person's sex, metabolic rate, body-mass composition, the thermic
    effects of food, and activity level.  The approximate energy expenditure of a man lying in bed is
    $1.0\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. For slow walking (just over two miles per hour),
    $3.0\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. For fast steady running (about 10 miles per hour),
    $16.3\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. Females expend about 10 per cent less energy than males of the same
    size doing a comparable activity.  For people weighing the same, individuals with a high percentage of body fat usually expend
    less energy than lean people, because fat is not as metabolically active as muscle.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:ERG-PER-GM-SEC,
            unit:MilliW-PER-MilliGM,
            unit:W-PER-GM,
            unit:W-PER-KiloGM ;
        qudt:hasDimensionVector qkdv:A0E0L2I0M0H0T-3D0 ;
        qudt:informativeReference "http://www.oxfordreference.com/display/10.1093/acref/9780198631477.001.0001/acref-9780198631477-e-594"^^xsd:anyURI ;
        qudt:specializationOf quantitykind:MassicPower ;
        rdfs:comment "Applicable units are those of quantitykind:SpecificPower"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> ;
        skos:broader quantitykind:MassicPower .

    quantitykind:EnergyFluenceRate a qudt:QuantityKind ;
        rdfs:label "Energy Fluence Rate"@en ;
        dcterms:description """"Energy Fluence Rate" can be used to describe the energy fluence delivered per unit time.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:BTU_IT-PER-FT2-HR,
