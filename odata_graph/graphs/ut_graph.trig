            "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB026"^^xsd:anyURI ;
        qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/year> ;
