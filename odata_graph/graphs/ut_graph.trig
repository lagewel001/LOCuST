        qudt:plainTextDescription """the rate at which a specific chemical element or compound changes concentration over time, where
    with concentration expressed as mass per volume. SI unit is kg * m-3 * s-1
  """^^xsd:string ;
        qudt:qkdvDenominator qkdv:A0E0L3I0M1H0T1D0 ;
