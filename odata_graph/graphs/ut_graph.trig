    unit:GALILEO a qudt:Unit ;
        rdfs:label "Galileo"^^xsd:string,
            "Galileo"@en ;
        dcterms:description """The $\\textit{Galileo}$ is the unit of acceleration of free fall used extensively in the science of
    gravimetry. The Galileo is defined as $1 \\textit{centimeter per square second}$ ($1 cm/s^2$). Unfortunately, the Galileo is
    often denoted with the symbol Gal, not to be confused with the Gallon that also uses the same symbol.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-GAUSS ;
        qudt:conversionMultiplier 0.01 ;
