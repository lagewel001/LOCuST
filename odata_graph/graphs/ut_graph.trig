        qudt:informativeReference "https://en.wikipedia.org/wiki/Superconductivity"^^xsd:anyURI ;
        qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI ;
        qudt:plainTextDescription """"Superconduction Transition Temperature" is the critical thermodynamic temperature of a
    superconductor.
  """^^xsd:string ;
        qudt:specializationOf quantitykind:Temperature ;
