    unit:FATH a qudt:Unit ;
        rdfs:label "Fathom"^^xsd:string,
            "Fathom"@en ;
        dcterms:description """A fathom = 1.8288 meters, is a unit of length in the imperial and the U.S. customary systems, used
    especially for measuring the depth of water. There are two yards in an imperial or U.S. fathom. Originally based on the
    distance between the man's outstretched arms, the size of a fathom has varied slightly depending on whether it was defined as
    a thousandth of an (Admiralty) nautical mile or as a multiple of the imperial yard.  Abbreviations: f, fath, fm, fth, fthm.
  """^^rdf:HTML ;
        qudt:applicableSystem sou:IMPERIAL,
            sou:USCS ;
        qudt:conversionMultiplier 1.8288 ;
        qudt:conversionMultiplierSN 1.8288e+00 ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Fathom"^^xsd:anyURI ;
        qudt:definedUnitOfSystem sou:USCS ;
        qudt:hasDimensionVector qkdv:A0E0L1I0M0H0T0D0 ;
        qudt:hasQuantityKind quantitykind:Length ;
        qudt:iec61360Code "0112/2///62720#UAB068"^^xsd:string ;
        qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB068"^^xsd:anyURI,
            "https://en.wikipedia.org/wiki/Fathom?oldid=493265429"^^xsd:anyURI ;
        qudt:scalingOf unit:M ;
