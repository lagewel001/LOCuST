    quantitykind:IonDensity a qudt:QuantityKind ;
        rdfs:label "Ion Density"@en ;
        dcterms:description "\"Ion Density\" is the number of ions per unit volume."^^qudt:LatexString ;
        qudt:applicableUnit unit:NUM-PER-L,
            unit:NUM-PER-M3,
            unit:NUM-PER-MicroL,
            unit:NUM-PER-MilliL,
