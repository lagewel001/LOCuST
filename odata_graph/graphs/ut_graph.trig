    unit:MilliDARCY a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Millidarcy"^^xsd:string,
            "Millidarcy"@en ;
        dcterms:description """
  The $\\textit{Millidarcy}$ ($md$) is a unit of permeability named after Henry Darcy.
  It is not an SI unit, but it is widely used in petroleum engineering and geology.
  The unit has also been used in biophysics and biomechanics, where the flow of fluids such as
  blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined.
  A millidarcy has dimensional units of $length^2$.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS,
            sou:SI ;
        qudt:conversionMultiplier 0.0000000000000009869233 ;
        qudt:conversionMultiplierSN 9.869233e-16 ;
        qudt:expression "$d$"^^qudt:LatexString ;
        qudt:hasDimensionVector qkdv:A0E0L2I0M0H0T0D0 ;
        qudt:hasQuantityKind quantitykind:HydraulicPermeability ;
        qudt:informativeReference "https://en.wikipedia.org/wiki/Darcy_(unit)"^^xsd:anyURI ;
        qudt:plainTextDescription """The millidarcy (md) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it
    is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the
    flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being
    examined. A millidarcy has dimensional units of length².
  """^^xsd:string ;
        qudt:prefix prefix:Milli ;
        qudt:scalingOf unit:DARCY ;
        qudt:symbol "md"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:HydraulicPermeability ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

    unit:MilliEQ-PER-DeciL a qudt:Unit ;
        rdfs:label "Milliequivalent per Decilitre"^^xsd:string,
            "Milliequivalent per Decilitre"@en,
            "Milliequivalent per Deciliter"@en-us ;
        dcterms:description "Milliequivalent per decilitre is occasionally used in clinical reporting where mass concentrations are also expressed per decilitre. One milliequivalent per decilitre equals ten milliequivalents per litre."^^xsd:string ;
        qudt:conversionMultiplier 10.0 ;
        qudt:conversionMultiplierSN 1e+01 ;
        qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb3261,
            _:ne65d4cbea54444c6960902e3884365fdb3262 ;
        qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
        qudt:plainTextDescription "Milliequivalent per decilitre; one milliequivalent per decilitre equals ten milliequivalents per litre."^^xsd:string ;
        qudt:symbol "mEq/dL"^^xsd:string ;
        qudt:ucumCode "mEQ.dL-1"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

    unit:MilliEQ-PER-L a qudt:Unit ;
        rdfs:label "Milliequivalent per Litre"^^xsd:string,
            "Milliequivalent per Litre"@en,
            "Milliequivalent per Liter"@en-us ;
        dcterms:description "Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting concentrations of electrolytes (sodium, potassium, chloride, bicarbonate, calcium, magnesium) in serum, plasma, and urine. One milliequivalent expresses the amount of an ionic species in terms of its chemical combining power, accounting for the ion's charge. For monovalent ions (Na+, K+, Cl-, HCO3-) one milliequivalent per litre equals one millimole per litre; for divalent ions (Ca2+, Mg2+) one milliequivalent per litre equals one half millimole per litre."^^xsd:string ;
        qudt:conversionMultiplier 1.0 ;
        qudt:conversionMultiplierSN 1e+00 ;
        qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb3265,
            _:ne65d4cbea54444c6960902e3884365fdb3266 ;
        qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
        qudt:plainTextDescription "Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting electrolyte concentrations in serum, plasma, and urine."^^xsd:string ;
        qudt:symbol "mEq/L"^^xsd:string ;
        qudt:ucumCode "mEQ.L-1"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

    unit:MilliEQ-PER-MilliL a qudt:Unit ;
        rdfs:label "Milliequivalent per Millilitre"^^xsd:string,
            "Milliequivalent per Millilitre"@en,
            "Milliequivalent per Milliliter"@en-us ;
        dcterms:description "Milliequivalent per millilitre is the unit commonly used to label intravenous electrolyte concentrate preparations such as potassium chloride concentrate (typically 2 mEq/mL) and sodium chloride concentrate. One milliequivalent per millilitre equals one thousand milliequivalents per litre, or one equivalent per litre."^^xsd:string ;
        qudt:conversionMultiplier 1000.0 ;
        qudt:conversionMultiplierSN 1e+03 ;
        qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb3267,
            _:ne65d4cbea54444c6960902e3884365fdb3268 ;
        qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
        qudt:plainTextDescription "Milliequivalent per millilitre; the unit commonly used to label intravenous electrolyte concentrate preparations."^^xsd:string ;
        qudt:symbol "mEq/mL"^^xsd:string ;
        qudt:ucumCode "mEQ.mL-1"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

