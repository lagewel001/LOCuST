            "número de massa"@pt,
            "nükleon numarası"@tr,
            "质量数"@zh ;
        dcterms:description """Number of nucleons in an atomic nucleus.A = Z+N. Nuclides with the same value of A are called isobars.
  """^^qudt:LatexString ;
