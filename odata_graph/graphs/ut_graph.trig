    quantitykind:RadiativeHeatTransfer a qudt:QuantityKind ;
        rdfs:label "Radiative Heat Transfer"@en ;
        dcterms:description """"Radiative Heat Transfer" is proportional to $(T_1^4 - T_2^4)$ and area of the surface, where $T_1$ and
