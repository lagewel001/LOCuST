    quantitykind:IntrinsicCarrierDensity a qudt:QuantityKind ;
        rdfs:label "Intrinsic Carrier Density"@en ;
        dcterms:description "\"Intrinsic Carrier Density\" is proportional to electron and hole densities."^^qudt:LatexString ;
        qudt:applicableUnit unit:NUM-PER-L,
