    quantitykind:MicroCanonicalPartitionFunction a qudt:QuantityKind ;
        rdfs:label "Micro Canonical Partition Function"@en ;
        dcterms:description """A "Micro Canonical Partition Function" applies to a micro canonical ensemble, in which the system is
    allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles.
  """^^qudt:LatexString ;
