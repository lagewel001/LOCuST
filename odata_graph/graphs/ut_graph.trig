    quantitykind:ThermalInsulance a qudt:QuantityKind ;
        rdfs:label "Thermal Insulance"@en ;
        dcterms:description """$\\textit{Thermal Insulance}$ is the reduction of heat transfer (the transfer of thermal energy between
    objects of differing temperature) between objects in thermal contact or in range of radiative influence. In building
    technology, this quantity is often called $\\textit{Thermal Resistance}$, with the symbol $R$.
  """^^qudt:LatexString ;
