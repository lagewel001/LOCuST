            unit:KiloA-HR,
            unit:KiloC,
            unit:KiloJ-PER-KiloV,
            unit:MegaC,
            unit:MicroC,
            unit:MilliA-HR,
            unit:MilliA-SEC,
            unit:MilliC,
            unit:NanoC,
            unit:PetaC,
            unit:PicoC,
            unit:PlanckCharge,
            unit:TeraC,
            unit:YoctoC,
            unit:YottaC,
            unit:ZeptoC,
            unit:ZettaC ;
        qudt:hasDimensionVector qkdv:A0E1L0I0M0H0T1D0 ;
        qudt:iec61360Code "0112/2///62720#UAD037"^^xsd:string ;
        qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
            "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD037"^^xsd:anyURI,
            "https://en.wikipedia.org/wiki/Electric_charge"^^xsd:anyURI,
            "https://en.wikipedia.org/wiki/Electric_charge?oldid=492961669"^^xsd:anyURI ;
        qudt:latexDefinition "$dQ = Idt$, where $I$ is electric current."^^qudt:LatexString ;
