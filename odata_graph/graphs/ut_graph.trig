    quantitykind:Heat a qudt:QuantityKind ;
        rdfs:label "حرارة"@ar,
            "jednotka tepla"@cs,
            "Wärme"@de,
            "Heat"@en,
            "calor"@es,
            "کمیت گرما"@fa,
