        qudt:plainTextDescription "Anzahl aller gleichzeitig belegten Einrichtungen in einer bestimmten Gruppe von einrichtungen"@de ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

