        qudt:normativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI ;
        qudt:plainTextDescription """In quantum mechanics and particle physics "Spin" is an intrinsic form of angular momentum carried
    by elementary particles, composite particles (hadrons), and atomic nuclei.
  """^^xsd:string ;
