        qudt:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI ;
        qudt:quantityValue constant:Value_ComptonWavelengthOver2Pi ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/constant> ;
