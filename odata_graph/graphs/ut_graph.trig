    quantitykind:PlaneAngle a qudt:QuantityKind ;
        rdfs:label "الزاوية النصف قطرية"@ar,
            "Равнинен ъгъл"@bg,
            "Rovinný úhel"@cs,
            "ebener Winkel"@de,
            "Επίπεδη γωνία"@el,
            "Plane Angle"@en,
            "ángulo plano"@es,
            "زاویه مستوی"@fa,
            "angle plan"@fr,
            "זווית"@he,
            "क्षेत्र"@hi,
            "szög"@hu,
            "angolo piano"@it,
            "弧度"@ja,
