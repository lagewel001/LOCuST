    unit:HectoPA a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Hectopascal"^^xsd:string,
            "Hectopascal"@cs,
            "Hectopascal"@de,
            "Hectopascal"@en,
            "Hectopascal"@es,
            "Hectopascal"@fr,
            "Hectopascal"@hu,
            "Ettopascal"@it,
            "Hectopascal"@ms,
            "Hectopaskal"@pl,
            "Hectopascal"@ro,
            "Hectopascal"@sl,
            "Hectopascal"@tr ;
        dcterms:description """Hectopascal is a unit of pressure. 1 Pa is approximately the pressure exerted by a 10-g mass resting on a
    1-cm2 area. 1013 hPa = 1 atm. There are 100 pascals in 1 hectopascal.
  """^^rdf:HTML ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-EMU,
            sou:CGS-GAUSS,
            sou:SI ;
        qudt:conversionMultiplier 100.0 ;
        qudt:conversionMultiplierSN 1e+02 ;
        qudt:exactMatch unit:MilliBAR ;
        qudt:hasDimensionVector qkdv:A0E0L-1I0M1H0T-2D0 ;
        qudt:hasQuantityKind quantitykind:ForcePerArea,
            quantitykind:ModulusOfElasticity ;
        qudt:iec61360Code "0112/2///62720#UAA527"^^xsd:string ;
        qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA527"^^xsd:anyURI ;
        qudt:prefix prefix:Hecto ;
        qudt:scalingOf unit:PA ;
        qudt:symbol "hPa"^^xsd:string ;
        qudt:ucumCode "hPa"^^qudt:UCUMcs ;
        qudt:uneceCommonCode "A97"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:ForcePerArea,
            quantitykind:ModulusOfElasticity ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q5139563> ;
        rdfs:comment """Hectopascal is commonly used in meteorology to report values for atmospheric pressure. It is equivalent to
    millibar.
  """^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

