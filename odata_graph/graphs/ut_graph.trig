        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb1501,
            _:ne65d4cbea54444c6960902e3884365fdb1502 ;
        qudt:hasQuantityKind quantitykind:InverseMagneticFlux ;
        qudt:symbol "Hz/V"^^xsd:string ;
        qudt:ucumCode "Hz.V-1"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:InverseMagneticFlux ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q101195156> ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

