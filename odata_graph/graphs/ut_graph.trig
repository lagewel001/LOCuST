        rdfs:label "out of scope"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/schema/shacl/qudt> .

    qudt:positiveDeltaLimit a rdf:Property ;
        rdfs:label "Positive delta limit"^^xsd:string ;
