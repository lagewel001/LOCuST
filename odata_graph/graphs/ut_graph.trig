            unit:THERM_EC,
            unit:THERM_US,
            unit:THM_EEC,
            unit:THM_US,
            unit:TON_FG-HR ;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Heat"^^xsd:anyURI ;
