    quantitykind:ThermalConductivity a qudt:QuantityKind ;
        rdfs:label "Thermal Conductivity"@en ;
        dcterms:description """In physics, thermal conductivity, $k$ (also denoted as $\\lambda$), is the property of a material's
    ability to conduct heat. It appears primarily in Fourier's Law for heat conduction and is the areic heat flow rate divided by
    temperature gradient.
  """^^qudt:LatexString ;
        qudt:applicableUnit unit:BTU_IT-FT-PER-FT2-HR-DEG_F,
