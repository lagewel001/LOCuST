    unit:MOHM a qudt:Unit ;
        rdfs:label "Mohm"^^xsd:string,
            "Mohm"@en ;
        dcterms:description """The $\\textit{Mohm}$ is a unit of mechanical mobility for sound waves, being the reciprocal of the
    mechanical $ohm$ unit of impedance, i.e., for an acoustic medium, the ratio of the flux or volumic speed (area times particle
    speed) of the resulting waves through it to the effective sound pressure (i.e. force) causing them, the unit being qualified,
    according to the units used, as m.k.s. or c.g.s. The mechanical ohm is defined as: $$Mohm \\equiv 1\\,dyn\\cdot\\,s\\cdot
    cm^{-1} \\text{ or } 10^{-3} N\\cdot s\\cdot m^{-1}$$.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS ;
        qudt:conversionMultiplier 1000.0 ;
        qudt:conversionMultiplierSN 1e+03 ;
        qudt:expression "$mohm$"^^qudt:LatexString ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M-1H0T1D0 ;
        qudt:hasQuantityKind quantitykind:MechanicalMobility ;
        qudt:informativeReference "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-914"^^xsd:anyURI ;
        qudt:latexDefinition "$1\\:{mohm_{cgs}} = 1\\:\\frac {cm} {dyn.s}\\: (=\\:1\\:\\frac s g \\:in\\:base\\:c.g.s.\\:terms)$"^^qudt:LatexString,
            "$1\\:{mohm_{mks}} = 10^{3}\\:\\frac m {N.s}\\:(=\\:10^{3}\\:   \\frac s {kg}\\:in\\:base\\:m.k.s.\\:terms)$"^^qudt:LatexString ;
        qudt:scalingOf unit:SEC-PER-KiloGM ;
        qudt:symbol "mohm"^^xsd:string ;
        qudt:unitForQuantityKind quantitykind:MechanicalMobility ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

