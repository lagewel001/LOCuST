        qudt:latexSymbol "$\\varphi$"^^qudt:LatexString ;
        qudt:plainTextDescription """"Fast Fission Factor" in an infinite medium, is the ratio of the mean number of neutrons produced
    by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.
  """^^xsd:string ;
        qudt:wikidataMatch <http://www.wikidata.org/entity/Q99197493> ;
        rdfs:comment "Applicable units are those of quantitykind:FastFissionFactor"^^xsd:string ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/quantitykind> .

