    unit:MilliARCSEC a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Milliarcsecond"^^xsd:string,
            "Milliarcsecond"@en ;
        dcterms:description """A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth
    (1/60) of one degree (circle/21,600), or $\\pi /10,800 radians$. In turn, a second of arc or arcsecond is one sixtieth (1/60)
    of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc
    is 1/21,600 of a rotation.  the milliarcsecond, abbreviated mas, is used in astronomy.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:USCS ;
        qudt:conversionMultiplier 0.00000000484813681 ;
        qudt:conversionMultiplierSN 4.848137e-09 ;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
