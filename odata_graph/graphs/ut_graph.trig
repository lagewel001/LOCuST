        qudt:latexDefinition "$\\kappa = \\frac{1}{\\rho}$, where $\\rho$ is the radius of the curvature."^^qudt:LatexString ;
        qudt:latexSymbol "$\\kappa$"^^qudt:LatexString ;
        qudt:plainTextDescription """In mathematics "Curvature" is the amount by which a geometric object deviates from being flat, or
    straight in the case of a line, but this is defined in different ways depending on the context.
  """^^xsd:string ;
