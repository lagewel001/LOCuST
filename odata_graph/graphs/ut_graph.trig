    unit:MicroFARAD a qudt:DerivedUnit,
            qudt:Unit ;
        rdfs:label "Microfarad"^^xsd:string,
            "Microfarad"@cs,
            "Microfarad"@de,
            "Microfarad"@en,
            "Microfaradio"@es,
            "Microfarad"@fr,
            "Microfarad"@hu,
            "Microfarad"@it,
            "Microfarad"@ms,
            "Microfarad"@pl,
            "Microfarad"@ro,
            "Microfarad"@sl,
            "Microfarad"@tr ;
        dcterms:description """The "microfarad" (symbolized $\\mu F$) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th
    power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF)
    circuits, capacitors with values on the order of $1 \\mu F$ or more are common. At radio frequencies (RF), a smaller unit, the
    picofarad (pF), is often used.
  """^^qudt:LatexString ;
        qudt:applicableSystem sou:CGS,
            sou:CGS-EMU,
            sou:CGS-GAUSS,
            sou:PLANCK,
            sou:SI ;
        qudt:conversionMultiplier 0.000001 ;
