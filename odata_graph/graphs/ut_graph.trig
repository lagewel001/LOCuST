    unit:EQ-PER-L a qudt:Unit ;
        rdfs:label "Equivalent per Litre"^^xsd:string,
            "Equivalent per Litre"@en,
            "Equivalent per Liter"@en-us ;
        dcterms:description "Equivalent per litre is a unit of equivalent concentration that expresses the amount of an ionic substance in equivalents per litre of solution. One equivalent is the amount of a substance that reacts with or supplies one mole of hydrogen ions in an acid-base reaction, transfers one mole of electrons in a redox reaction, or carries one mole of elementary charge. The numeric value of a concentration in Eq/L differs from the corresponding molar concentration in mol/L by the equivalence factor of the substance: for a species with equivalence factor n, 1 mol/L equals n Eq/L."^^xsd:string ;
        qudt:conversionMultiplier 1000.0 ;
        qudt:conversionMultiplierSN 1e+03 ;
        qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
        qudt:hasFactorUnit _:ne65d4cbea54444c6960902e3884365fdb959,
            _:ne65d4cbea54444c6960902e3884365fdb960 ;
        qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
        qudt:plainTextDescription "Equivalent per litre is a unit of equivalent concentration expressing the amount of an ionic substance in equivalents per litre of solution."^^xsd:string ;
        qudt:symbol "Eq/L"^^xsd:string ;
        qudt:ucumCode "EQ.L-1"^^qudt:UCUMcs ;
        qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
        rdfs:isDefinedBy <http://qudt.org/3.4.0/vocab/unit> .

