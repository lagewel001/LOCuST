    quantitykind:LogOctanolAirPartitionCoefficient a qudt:QuantityKind ;
        rdfs:label "Octanol Air Partition Coefficient"@en ;
        dcterms:description """A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase
    mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound
