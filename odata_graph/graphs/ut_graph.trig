        qudt:symbol "lx"^^xsd:string ;
        qudt:ucumCode "lx"^^qudt:UCUMcs ;
        qudt:udunitsCode "lx"^^xsd:string ;
        qudt:uneceCommonCode "LUX"^^xsd:string ;
